{
  "name": "@artevelde-uas/canvas-lms-sprintplus-accessibility-toggle-plugin",
  "version": "0.1.1",
  "description": "Adds a toggle switch to the user's accessibility settings in Canvas LMS for enabling/disabling the Sprint+ Websprinter UI.",
  "keywords": [
    "Canvas LMS",
    "Accessibility",
    "Sprint+",
    "Websprinter"
  ],
  "license": "ISC",
  "author": "Renaat De Muynck <renaat.demuynck@arteveldehs.be>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/artevelde-uas/canvas-lms-sprintplus-accessibility-toggle-plugin.git"
  },
  "module": "src/index.js",
  "files": [
    "src/",
    "locales/"
  ],
  "packageManager": "yarn@4.18.0",
  "scripts": {
    "dev": "run-p serve watch",
    "watch": "webpack ./index.js --watch --progress --stats minimal --config webpack.config.js",
    "build": "canvas-build",
    "serve": "canvas-server-start"
  },
  "peerDependencies": {
    "@artevelde-uas/canvas-lms-app": "^1.14.0"
  },
  "devDependencies": {
    "@artevelde-uas/canvas-lms-app": "1",
    "@artevelde-uas/canvas-lms-theme-dev": "0.4",
    "npm-run-all": "^4.1.5"
  },
  "dependencies": {
    "p-timeout": "5.1.0"
  }
}
